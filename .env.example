# Copy to .env and adjust. .env is NEVER versioned; this example is.
# Values already present in the real environment win over this file.

# development | testing | production
FORJA_ENV=development

# Required in production (at least 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Empty = SQLite file in instance/forja.db (development).
# PostgreSQL (production): postgresql+psycopg://user:password@host:5432/forja
DATABASE_URL=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG
# Folder for forja.log (JSON lines, rotated at 5 MB x 5 files)
LOG_DIR=logs

# Rate limiter storage. memory:// is per process; use Redis with several workers:
#   redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# Log SQL statements (development only)
SQLALCHEMY_ECHO=0

# Email. log = keep messages in the log (development); smtp = deliver (required in production)
MAIL_BACKEND=log
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Forja <no-reply@forja.local>
