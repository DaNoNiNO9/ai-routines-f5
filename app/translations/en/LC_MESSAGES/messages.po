msgstr "If you withdraw it, we stop processing your health data and delete it right now, for good:"

#: app/templates/privacy/withdraw.html:10
msgid "tus respuestas del cuestionario, tu plan, tu rutina y su historial;"
msgstr "your questionnaire answers, your plan, your routine and their history;"

#: app/templates/privacy/withdraw.html:11
msgid "pesajes, medidas, comida, pasos, entrenos y series;"
msgstr "weigh-ins, measurements, food, steps, workouts and sets;"

#: app/templates/privacy/withdraw.html:12
msgid "tu material, molestias y lesiones."
msgstr "your equipment, aches and injuries."

#: app/templates/privacy/withdraw.html:14
