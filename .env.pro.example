# Entorno de producción local para enseñarlo por un túnel de Cloudflare (docs/DEMO_PRO.md).
# Copia a .env.pro (nunca se versiona) y pon un SECRET_KEY propio:
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
ALZA_ENV=production
SECRET_KEY=
# Base de datos aparte de la de desarrollo.
DATABASE_URL=sqlite:///instance/alza-pro.db
LOG_LEVEL=INFO
LOG_DIR=logs-pro
# Producción exige SMTP. Sin un servidor de correo real, recuperar la contraseña
# avisa de que no se pudo enviar el correo; el resto funciona.
MAIL_BACKEND=smtp
MAIL_SERVER=localhost
MAIL_FROM=Alza <no-reply@alza.fit>
# Sin muro de pago: quien lo pruebe ve también lo de Pro, sin pagar.
# (Con PAYWALL_ENABLED=true producción exige Stripe real.)
BILLING_BACKEND=fake
PAYWALL_ENABLED=false
# Detrás del túnel: https y el dominio público llegan en cabeceras.
BEHIND_PROXY=true
